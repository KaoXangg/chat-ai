# ============================================
# Chat AI - Backend Environment Variables
# Sao chép tệp này thành ".env" rồi điền các giá trị thực tế.
# KHÔNG commit / gửi tệp .env (chứa key thật) cho người khác.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Cơ sở dữ liệu (SQL Server cục bộ hoặc Azure SQL) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=chat_ai
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password
# Đặt encrypt=true khi dùng Azure SQL; đặt trustServerCertificate=true khi dùng
# SQL Server cục bộ với chứng chỉ tự ký (self-signed).
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- JWT ---
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-that-dai-va-kho-doan
JWT_EXPIRES_IN=7d

# --- Tài khoản quản trị mặc định (dùng cho lệnh: npm run seed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@chatai.local
ADMIN_PASSWORD=doi-mat-khau-admin-manh

# --- API key của các nhà cung cấp AI ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Tavily (tìm kiếm web, tùy chọn): https://app.tavily.com
TAVILY_API_KEY=

# --- Email quên mật khẩu (tùy chọn; bỏ trống thì /forgot-password trả 503) ---
# Gmail: dùng "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu đăng nhập.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Giới hạn tốc độ (số yêu cầu chat tối đa trên mỗi người dùng/phút) ---
CHAT_RATE_LIMIT_PER_MINUTE=10

# --- Giới hạn ngữ cảnh gửi cho AI (token) ---
# Mỗi lần gọi AI, hệ thống tự bỏ bớt tin nhắn cũ để không vượt min(70% độ dài ngữ cảnh của model, giá trị này).
# Giảm số này nếu gặp lỗi 413/429 (quá nhiều token) trên gói free; mặc định 12000.
MAX_CONTEXT_TOKENS=12000

# --- Hạn mức token theo ngày ---
# Múi giờ dùng để tính mốc làm mới 00:00 hằng ngày (7 = giờ Việt Nam, GMT+7).
QUOTA_TZ_OFFSET_HOURS=7
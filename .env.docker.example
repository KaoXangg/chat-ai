# ============================================================
# Chat AI - Cấu hình Docker Local / Dev (.env.docker)
# Sao chép file này thành .env.docker trước khi chạy Docker Compose:
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
# ============================================================

# --- SQL Server ---
MSSQL_SA_PASSWORD=ChatAi@StrongPass2026!
DB_HOST=db
DB_PORT=1433
DB_NAME=chat_ai
DB_USER=sa
DB_PASSWORD=ChatAi@StrongPass2026!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Backend Application ---
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:80
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
TRUST_PROXY=1

# --- Security & JWT ---
# Khóa bí mật JWT (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=change-this-to-a-very-long-and-secure-random-secret-for-docker
JWT_EXPIRES_IN=7d
# Khóa 64 ký tự hex mã hóa API key trong database
API_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Tài khoản Admin mặc định khi seed ---
ADMIN_USERNAME=Administrator
ADMIN_EMAIL=admin@chatai.local
ADMIN_PASSWORD=AdminStrongPassword123!

# --- Cấu hình AI Provider (Điền ít nhất 1 key hoặc cấu hình qua Admin UI) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# --- Frontend ---
FRONTEND_PORT=80
VITE_API_URL=/api
